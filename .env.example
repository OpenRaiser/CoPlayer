# Copy to .env, fill in, then: set -a; . ./.env; set +a

# local copy of the dataset (hf download OpenRaiser/CoPlayBench --repo-type dataset --local-dir data/CoPlayBench)
COPLAY_DATA=data/CoPlayBench
# frame cache (~15 GB for the full benchmark) and outputs
COPLAY_FRAMES=cache/frames
COPLAY_OUT=outputs

# OpenAI-compatible endpoint of the models under test (a provider, a gateway, or a local vLLM server)
COPLAY_BASE_URL=https://api.example.com/v1
COPLAY_API_KEY=sk-...
# judge endpoint (defaults to the values above); the paper's judge is qwen3.8-flash with thinking disabled
COPLAY_JUDGE_BASE_URL=
COPLAY_JUDGE_API_KEY=
# requests per minute for one process
COPLAY_RPM=500
# FFMPEG=/usr/bin/ffmpeg

# RL training only: the reward judge server started with training/rl/serve_judge.sh
COPLAY_REWARD_URL=http://127.0.0.1:8200/v1
COPLAY_REWARD_API_KEY=
